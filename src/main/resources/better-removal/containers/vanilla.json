{
  "_comment": "Vanilla containers. match accepts several candidates separated by commas: the block id comes first for precision, the @class fallback keeps the rule working even if the block id changes.",
  "containers": [
    {
      "match": "minecraft:furnace, @net.minecraft.world.level.block.entity.FurnaceBlockEntity",
      "config": "furnace",
      "default": true,
      "size": 3,
      "extract": { "input": [0], "fuel": [1], "output": [2] },
      "deposit": { "input": [0], "fuel": [1] }
    },
    {
      "match": "minecraft:blast_furnace, @net.minecraft.world.level.block.entity.BlastFurnaceBlockEntity",
      "config": "blast_furnace",
      "default": true,
      "size": 3,
      "extract": { "input": [0], "fuel": [1], "output": [2] },
      "deposit": { "input": [0], "fuel": [1] }
    },
    {
      "match": "minecraft:smoker, @net.minecraft.world.level.block.entity.SmokerBlockEntity",
      "config": "smoker",
      "default": true,
      "size": 3,
      "extract": { "input": [0], "fuel": [1], "output": [2] },
      "deposit": { "input": [0], "fuel": [1] }
    },
    {
      "_note": "0-2 potions (output), 3 ingredient slot (nether wart etc), 4 fuel slot (blaze powder)",
      "match": "minecraft:brewing_stand, @net.minecraft.world.level.block.entity.BrewingStandBlockEntity",
      "config": "brewing_stand",
      "default": true,
      "size": 5,
      "extract": { "input": [0, 1, 2, 3], "fuel": [4], "output": [0, 1, 2] },
      "deposit": { "input": [3], "fuel": [4] }
    },
    {
      "_note": "A container with no input/fuel distinction: every slot counts as both input and output, so all three slot presets reach it. Uses * and therefore declares no size",
      "match": "minecraft:hopper",
      "config": "hopper",
      "default": true,
      "extract": { "input": "*", "fuel": "*", "output": "*" },
      "deposit": { "input": "*", "fuel": "*" }
    },
    {
      "_note": "Dispenser and dropper share the DispenserBlockEntity class, so they are told apart by block id only, with no @class fallback",
      "match": "minecraft:dispenser",
      "config": "dispenser",
      "default": true,
      "extract": { "input": "*", "fuel": "*", "output": "*" },
      "deposit": { "input": "*", "fuel": "*" }
    },
    {
      "match": "minecraft:dropper",
      "config": "dropper",
      "default": true,
      "extract": { "input": "*", "fuel": "*", "output": "*" },
      "deposit": { "input": "*", "fuel": "*" }
    }
  ]
}
