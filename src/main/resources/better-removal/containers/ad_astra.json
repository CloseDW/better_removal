{
  "_comment": "Ad Astra machines. None of them has a fuel slot, so the FUEL preset finds no slots on them.",
  "containers": [
    {
      "_note": "Compressor: 0 energy, 1 input, 2 output",
      "match": "ad_astra:compressor, @earth.terrarium.adastra.common.blockentities.machines.CompressorBlockEntity",
      "config": "compressor",
      "default": true,
      "size": 3,
      "extract": { "input": [1], "output": [2] },
      "deposit": { "input": [1] }
    },
    {
      "_note": "Etrionic Blast Furnace: 0 energy, 1-4 inputs, 5-8 outputs",
      "match": "ad_astra:etrionic_blast_furnace, @earth.terrarium.adastra.common.blockentities.machines.EtrionicBlastFurnaceBlockEntity",
      "config": "etrionic_blast_furnace",
      "default": true,
      "size": 9,
      "extract": { "input": [1, 2, 3, 4], "output": [5, 6, 7, 8] },
      "deposit": { "input": [1, 2, 3, 4] }
    },
    {
      "_note": "Fuel Refinery: 0 energy, 1 input (crude oil), 2 output (empty bucket), 3 fluid input, 4 output (filled bucket)",
      "match": "ad_astra:fuel_refinery, @earth.terrarium.adastra.common.blockentities.machines.FuelRefineryBlockEntity",
      "config": "fuel_refinery",
      "default": true,
      "size": 5,
      "extract": { "input": [1, 3], "output": [2, 4] },
      "deposit": { "input": [1, 3] }
    },
    {
      "_note": "Oxygen Loader: 0 battery, 1 input (water bucket), 2 output (empty bucket), 3 fluid input, 4 output",
      "match": "ad_astra:oxygen_loader, @earth.terrarium.adastra.common.blockentities.machines.OxygenLoaderBlockEntity",
      "config": "oxygen_loader",
      "default": true,
      "size": 5,
      "extract": { "input": [1, 3], "output": [2, 4] },
      "deposit": { "input": [1, 3] }
    },
    {
      "_note": "Cryo Freezer: 0 energy, 1 input, 2 fluid input, 3 output",
      "match": "ad_astra:cryo_freezer, @earth.terrarium.adastra.common.blockentities.machines.CryoFreezerBlockEntity",
      "config": "cryo_freezer",
      "default": true,
      "size": 4,
      "extract": { "input": [1, 2], "output": [3] },
      "deposit": { "input": [1, 2] }
    }
  ]
}
